---
import { getCollection } from 'astro:content';
import { src } from '../lib/base';
import { sortCategories } from '../content.config';

const path = Astro.url.pathname;

// 分类由 frontmatter 自动聚合，新增文章无需改动导航代码
const posts = await getCollection('posts');
const categories = sortCategories([...new Set(posts.map((p) => p.data.category))]);

const links = [
  { href: src(''), label: '首页', key: 'home' },
  { href: src('posts/'), label: '文章', key: 'posts' },
  { href: src('about/'), label: '关于', key: 'about' },
];

const isActive = (key: string) =>
  key === 'home' ? path === src('') || path === '/' : path.startsWith(src(key));

const catActive = categories.some((c) => path.startsWith(src(`category/${c}/`)));
---

<nav class="nav">
  <div class="wrap nav__inner">
    <a class="nav__brand" href={src('')}>
      罗语墨 <em>课程作业与论文</em>
    </a>

    <ul class="nav__links" data-nav-links>
      {
        links.map((l) => (
          <li>
            <a
              class="nav__link"
              href={l.href}
              aria-current={isActive(l.key) ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }

      <li class="nav__drop">
        <button
          class="nav__link nav__drop-btn"
          type="button"
          data-drop-btn
          aria-expanded={catActive ? 'true' : 'false'}
        >
          分类
          <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true">
            <path d="M1 1.5 4.5 5 8 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
          </svg>
        </button>
        <ul class="nav__drop-menu" data-drop-menu>
          {
            categories.map((c) => (
              <li>
                <a
                  class="nav__link"
                  href={src(`category/${c}/`)}
                  aria-current={
                    path.startsWith(src(`category/${c}/`)) ? 'page' : undefined
                  }
                >
                  {c}
                </a>
              </li>
            ))
          }
        </ul>
      </li>

      <li>
        <a
          class="nav__link nav__link--icon"
          href={src('rss.xml')}
          aria-label="RSS 订阅"
          title="RSS 订阅"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <circle cx="6" cy="19" r="1.6" fill="currentColor" stroke="none"></circle>
            <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" stroke-linecap="round"></path>
          </svg>
        </a>
      </li>
    </ul>

    <div class="nav__tools">
      <button class="icon-btn" data-theme-toggle aria-label="切换深浅色主题">
        <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" stroke-linecap="round"></path>
        </svg>
      </button>

      <button class="nav__burger" data-burger aria-label="打开菜单" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<style>
  .nav__drop {
    position: relative;
  }

  .nav__drop-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    border: none;
    background: none;
    font-family: inherit;
    cursor: pointer;
  }

  .nav__drop-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 140px;
    margin: 0;
    padding: 5px;
    list-style: none;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0.15s;
  }

  .nav__drop:hover .nav__drop-menu,
  .nav__drop-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav__drop-menu .nav__link {
    display: block;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .nav__drop-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      border: none;
      background: none;
      padding: 0 0 0 12px;
      min-width: 0;
    }
  }
</style>

<script is:inline>
  // 分类下拉：移动端点击展开，桌面端 hover 由 CSS 处理
  var dropBtn = document.querySelector('[data-drop-btn]');
  var dropMenu = document.querySelector('[data-drop-menu]');
  if (dropBtn && dropMenu) {
    dropBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = dropMenu.classList.toggle('is-open');
      dropBtn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', function () {
      dropMenu.classList.remove('is-open');
      dropBtn.setAttribute('aria-expanded', 'false');
    });
  }
</script>
