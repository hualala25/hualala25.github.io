---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import IndexItem from '../../components/IndexItem.astro';
import { src } from '../../lib/base';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const categories = [...new Set(posts.map((p) => p.data.category))];
---

<Base title="全部文章 · 罗语墨" description="按分类浏览全部内容">
  <Nav />

  <main id="main" class="page">
    <div class="wrap">
      <header class="page__head">
        <h1 class="page__title">全部文章</h1>
        <p class="page__sub">共 {posts.length} 篇</p>
        <ul class="cats">
          {
            categories.map((c) => (
              <li>
                <a class="tag" href={src(`category/${c}/`)}>
                  {c}
                </a>
              </li>
            ))
          }
        </ul>
      </header>

      <ul class="index">
        {
          posts.map((p) => (
            <li>
              <IndexItem post={p} />
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .index {
    margin: 30px 0 0;
  }
</style>
