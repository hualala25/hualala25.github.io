---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import IndexItem from '../components/IndexItem.astro';
import { src } from '../lib/base';
import { sortCategories } from '../content.config';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// 分类完全由 frontmatter 聚合，新增文章无需改页面代码
const categories = sortCategories([...new Set(posts.map((p) => p.data.category))]);
const counts = Object.fromEntries(
  categories.map((c) => [c, posts.filter((p) => p.data.category === c).length]),
);

const total = posts.length;
---

<Base title="罗语墨 · 课程作业与论文" description="课程作业与学年论文的整理记录">
  <Nav />

  <main id="main">
    <section class="intro">
      <div class="wrap">
        <h1 class="intro__name">罗语墨</h1>
        <p class="intro__desc">课程作业与学年论文</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <ul class="index" data-post-list>
          {
            posts.map((p) => (
              <li>
                <IndexItem post={p} />
              </li>
            ))
          }
        </ul>

        <p class="index__more">
          <span>共 {total} 篇</span>
          {
            categories.map((c) => (
              <a href={src(`category/${c}/`)}>
                {c} {counts[c]}
              </a>
            ))
          }
          <a href={src('posts/')}>全部文章</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .intro {
    padding: 84px 0 40px;
  }

  .intro__name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(28px, 4.5vw, 38px);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .intro__desc {
    margin: 8px 0 0;
    font-size: 14px;
    color: var(--ink-faint);
  }


  .index__more {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 26px 0 0;
    font-size: 13.5px;
    color: var(--ink-faint);
  }

  .index__more a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .index__more a:hover {
    color: var(--primary-deep);
    text-decoration-color: var(--primary);
  }

  @media (max-width: 760px) {
    .intro {
      padding: 56px 0 30px;
    }
  }
</style>
